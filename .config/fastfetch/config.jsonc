// Inspired by Catnap
{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "kitty-direct",
		"source": "~/Downloads/catppuccin_logo.png",
		"width": 22,
		"height": 12,
		"padding": {
			"top": 2
		}
	},
	"display": {
		"separator": " "
	},
	"modules": [
		{
			"key": "╭───────────╮",
			"type": "custom",
			"keyColor": "white"
		},
		{
			"key": "│ {#31} user    {#keys}│",
			"type": "title",
			"format": "{user-name}",
			"keyColor": "white"

		},
		{
			"key": "│ {#32}󰇅 hname   {#keys}│",
			"type": "title",
			"format": "{host-name}",
			"keyColor": "white",

		},
		{
			"key": "│ {#31} battery {#keys}│",
			"type": "battery",
			"keyColor": "white"

		},
		{
			"key": "│ {#33}󰅐 uptime  {#keys}│",
			"type": "uptime",
			"keyColor": "white"

		},
		{
			"key": "│ {#34}{icon} distro  {#keys}│",
			"type": "os",
			"keyColor": "white"

		},
		{
			"key": "│ {#35} kernel  {#keys}│",
			"type": "kernel",
			"keyColor": "white"

		},
		{
			"key": "│ {#36}󰇄 wm      {#keys}│",
			"type": "wm",
			"keyColor": "white"

		},
		{
			"key": "│ {#31} term    {#keys}│",
			"type": "terminal",
			"keyColor": "white"

		},
		{
			"key": "│ {#32} shell   {#keys}│",
			"type": "shell",
			"keyColor": "white"

		},
		{
			"key": "│ {#33}󰍛 cpu     {#keys}│",
			"type": "cpu",
			"showPeCoreCount": true,
			"keyColor": "white"

		},
		{
			"key": "│ {#34}󰉉 disk    {#keys}│",
			"type": "disk",
			"folders": "/",
			"keyColor": "white"

		},
		{
			"key": "│ {#35} memory  {#keys}│",
			"type": "memory",
			"keyColor": "white"

		},
		{
			"key": "│ {#34}󰩟 network {#keys}│",
			"type": "localip",
			"format": "{ipv4} ({ifname})",
			"keyColor": "white"

		},
		{
			"key": "├───────────┤",
			"type": "custom",
			"keyColor": "white"

		},
		{
			"key": "│ {#39} colors  {#keys}│",
			"type": "colors",
			"symbol": "circle"

		},
		{
			"key": "╰───────────╯",
			"type": "custom",
			"keyColor": "white"

		}
	]
}
